# Copy to .env.docker (gitignored) and use: docker compose --env-file .env.docker up --build
# SQL Server requires 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=ChangeMe123!
# Shared by every service - AuthService signs with it, the others validate with it. At least 32 chars.
JWT_SECRET=s9q3NdzqUAKsdeQ3d71PaPV0JUkyEKzO
# Optional: lets AuthService actually send email via SMTP (Brevo) - else emails are only logged.
# SMTP_PASSWORD is the Brevo SMTP key; FROM must be a sender verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=bb76ed001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@schoolsphrere.com
SMTP_FROM_NAME=School Sphere
# Online classes (MeetingService + LiveKit). Generate real values, e.g. `docker run --rm livekit/livekit-server:v1.13.7 generate-keys`.
# The LiveKit secret must be at least 32 characters.
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Shared by MeetingService (sender) and EngagementService (receiver) for internal events. At least 32 chars.
SERVICE_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional: Web Push for class reminders on phones. Generate a VAPID pair, e.g. `npx web-push generate-vapid-keys`.
# Leave empty to turn push off (in-app notifications still work).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Razorpay online fee payment (School Sphere Student app). Leave empty to hide "Pay online".
# Test keys start with rzp_test_. The webhook secret is the one you set on the Razorpay dashboard webhook
# (URL: https://<your-gateway>/services/finance/api/payments/razorpay/webhook, events: payment.captured, payment.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Image names for `docker compose build` / `push` (GitHub Container Registry). Defaults shown.
# GHCR_REGISTRY=ghcr.io/786shameempk
# IMAGE_TAG=latest

# AI assistant (AiService). AI_PROVIDER: Mock (no key, canned answers) | Anthropic | OpenAI | AzureOpenAI | Local.
# Keys stay in the backend container only. Leave unused providers empty.
AI_PROVIDER=Mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LOCAL_LLM_URL=http://host.docker.internal:11434/v1/
AI_DAILY_REQUESTS_PER_USER=100
AI_MONTHLY_TOKENS_PER_SCHOOL=1000000
# Study-material search (RAG). Mock = demo vectors; set OpenAI, AzureOpenAI or Local for real semantic search.
AI_EMBEDDINGS_PROVIDER=Mock
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
