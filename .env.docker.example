# Copy to .env.docker (gitignored) and use: docker compose --env-file .env.docker up --build
# SQL Server requires 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=ChangeMe123!
# Shared by every service - AuthService signs with it, the others validate with it. At least 32 chars.
JWT_SECRET=s9q3NdzqUAKsdeQ3d71PaPV0JUkyEKzO
# RS256 signing (recommended; see AuthService/docs/JWT_KEY_ROLLOUT.md). Make a pair with: node ../AuthService/scripts/new-jwt-keypair.mjs <folder outside the repo>
# JWT_PRIVATE_KEY_PEM goes to AuthService ONLY (one line, 
 for line breaks). JWT_PUBLIC_KEY_PEM goes to every service and is safe to share.
# When every service has the public key, set JWT_ACCEPT_LEGACY_HS256=false and delete JWT_SECRET.
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# JWT_ACCEPT_LEGACY_HS256=true
# Optional: lets AuthService actually send email via SMTP (Brevo) - else emails are only logged.
# SMTP_PASSWORD is the Brevo SMTP key; FROM must be a sender verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=bb76ed001@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@schoolsphrere.com
SMTP_FROM_NAME=School Sphere
# Online classes (MeetingService + LiveKit). Generate real values, e.g. `docker run --rm livekit/livekit-server:v1.13.7 generate-keys`.
# The LiveKit secret must be at least 32 characters.
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Shared by MeetingService (sender) and EngagementService (receiver) for internal events. At least 32 chars.
SERVICE_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional: Web Push for class reminders on phones. Generate a VAPID pair, e.g. `npx web-push generate-vapid-keys`.
# Leave empty to turn push off (in-app notifications still work).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Razorpay online fee payment (School Sphere Student app). Leave empty to hide "Pay online".
# Test keys start with rzp_test_. The webhook secret is the one you set on the Razorpay dashboard webhook
# (URL: https://<your-gateway>/services/finance/api/payments/razorpay/webhook, events: payment.captured, payment.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Online payment gateways. Each school saves its own keys under Fees -> Payment gateways (encrypted); nothing below is needed for that.
# The Razorpay keys above are only a platform-wide default for schools that saved none. These two are the public addresses
# gateways return payers and webhooks to (required for Stripe, Cashfree and PayU redirects).
PAYMENTS_APP_BASE_URL=http://localhost:5173
PAYMENTS_API_BASE_URL=http://localhost:5137
# Retention (days, 0 = keep) and the public certificate look-up rate limit.
RETENTION_VISITOR_ID_PROOF_DAYS=90
RETENTION_VISITOR_SCAN_DAYS=90
RETENTION_CERTIFICATE_VERIFICATION_DAYS=180
RATE_LIMIT_PUBLIC_VERIFY_PER_MINUTE=20

# Image names for `docker compose build` / `push` (GitHub Container Registry). Defaults shown.
# GHCR_REGISTRY=ghcr.io/786shameempk
# IMAGE_TAG=latest

# AI assistant (AiService). AI_PROVIDER: Mock (no key, canned answers) | Anthropic | OpenAI | AzureOpenAI | Local.
# Keys stay in the backend container only. Leave unused providers empty.
AI_PROVIDER=Mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LOCAL_LLM_URL=http://host.docker.internal:11434/v1/
AI_DAILY_REQUESTS_PER_USER=100
AI_MONTHLY_TOKENS_PER_SCHOOL=1000000
# Study-material search (RAG). Mock = demo vectors; set OpenAI, AzureOpenAI or Local for real semantic search.
AI_EMBEDDINGS_PROVIDER=Mock
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ── Attendance capture (QR / RFID / biometric / face) ─────────────────────────
# Signs QR attendance passes and hashes card ids. Long random string; changing it invalidates linked cards (re-link them).
ATTENDANCE_SIGNING_KEY=
# Face recognition: None, or CompreFace (self-hosted). Leave None until a face service is running and consent is collected.
FACE_RECOGNITION_PROVIDER=None
# e.g. http://compreface-api:8080 on the private network, and the API key of a CompreFace Recognition service.
COMPREFACE_URL=
COMPREFACE_API_KEY=
# ── Communication Center delivery (SMS / email / WhatsApp) ─────────────────────
# Each school connects its own providers in Communication → Settings (secrets are stored encrypted in the database).
# Public URL providers call back on (delivery receipts). Live/Azure use https://APP_DOMAIN automatically.
MESSAGING_PUBLIC_BASE_URL=
# Optional: send email for schools without their own provider through the SMTP_* relay above. Smtp or empty.
PLATFORM_EMAIL_PROVIDER=
