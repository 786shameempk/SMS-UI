# Copy to .env on the VM (never commit the real one) and fill in every value.
# Generate secrets with:  openssl rand -base64 48

# ── Public addresses ──────────────────────────────────────────────────────────
# Must have a DNS A record pointing at the VM's public IP.
DOMAIN=sms-schoolsphere.com
# Optional: more domains (space-separated) with A records to the same IP; they redirect to DOMAIN.
EXTRA_DOMAINS=www.sms-schoolsphere.com
# Let's Encrypt account + Web Push contact.
ACME_EMAIL=admin@example.com
# Optional: another site allowed to call the APIs cross-origin, e.g. the Azure Static Web Apps frontend
# (scheme + host, no trailing slash): https://wonderful-sand-0233cf710.<n>.azurestaticapps.net
# CORS_EXTRA_ORIGIN=

# ── Images (GitHub Container Registry) ────────────────────────────────────────
GHCR_REGISTRY=ghcr.io/786shameempk
# "latest" = master; pin a short SHA (e.g. sha-1a2b3c4) or version (1.2.3) for predictable deploys/rollbacks.
IMAGE_TAG=latest
UI_IMAGE_TAG=latest

# ── Core secrets ──────────────────────────────────────────────────────────────
# SQL Server: 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=
# Shared by every service (AuthService signs, the rest validate). 32+ chars.
JWT_SECRET=AETMpNLr5P2tg9h2ZuYrfN0fJHDTKsZO9aSpAcFJolP
# MeetingService -> EngagementService internal events. 32+ chars.
SERVICE_AUTH_SECRET=AETMpNLr5P2tg9h2ZuYrfN0fJHDTKsZO9aSpAcFJolP
# SQL Server edition: Express (free, 10 GB/db), or Standard/Enterprise if you hold a licence.
MSSQL_PID=Express

# ── LiveKit (in-app video classes) ────────────────────────────────────────────
# Shared by LiveKit, Egress and MeetingService. Any key name (e.g. APIsms) and a secret of 32+ chars
# (openssl rand -base64 48). Open 7881/tcp, 7882/udp and 3478/udp in the VM's network security group.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Class recording through Egress. Set to false on a small VM (each recording uses about 2-4 vCPUs).
LIVEKIT_EGRESS_ENABLED=true

# ── File storage (Azure Blob Storage) ─────────────────────────────────────────
# Storage account > Security + networking > Access keys > Connection string. Every uploaded file goes here;
# on first start the services copy existing files from the old volumes and the database into it.
AZURE_STORAGE_CONNECTION_STRING=

# ── Email (SMTP / Brevo) - leave SMTP_PASSWORD empty to only log emails ───────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=bb76ed001@smtp-brevo.com
# Brevo SMTP key (SMTP & API > SMTP). Secret - set it only in the VM's .env.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@sms-schoolsphere.com
SMTP_FROM_NAME=School Sphere

# Landing-page lead notifications.
LEAD_NOTIFY_EMAIL=info@sms-schoolsphere.com
LEAD_NOTIFY_WHATSAPP=

# ── AI (AiService) ────────────────────────────────────────────────────────────
# Provider: Mock (no key; chat answers from school data only, generators refuse), OpenAI, Anthropic or AzureOpenAI.
# Keys live only here on the VM - never in appsettings.json or the repo.
AI_PROVIDER=Mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Study-material search: Mock (keyword demo), OpenAI or AzureOpenAI (needs the key above).
AI_EMBEDDINGS_PROVIDER=Mock
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Usage limits. Whole-class report remarks use one request per student.
AI_DAILY_REQUESTS_PER_USER=100
AI_MONTHLY_TOKENS_PER_SCHOOL=1000000

# ── Optional integrations ─────────────────────────────────────────────────────
# Web Push (npx web-push generate-vapid-keys). Empty = push off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Razorpay online fee payment. Empty = "Pay online" hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
