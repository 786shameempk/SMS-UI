# Copy to .env on the VM (never commit the real one) and fill in every value.
# Generate secrets with:  openssl rand -base64 48

# ── Public addresses ──────────────────────────────────────────────────────────
# Must have a DNS A record pointing at the VM's public IP.
DOMAIN=app.example.com
# Let's Encrypt account + Web Push contact.
ACME_EMAIL=admin@example.com

# ── Images (GitHub Container Registry) ────────────────────────────────────────
GHCR_REGISTRY=ghcr.io/786shameempk
# "latest" = master; pin a short SHA (e.g. sha-1a2b3c4) or version (1.2.3) for predictable deploys/rollbacks.
IMAGE_TAG=latest
UI_IMAGE_TAG=latest

# ── Core secrets ──────────────────────────────────────────────────────────────
# SQL Server: 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=
# Shared by every service (AuthService signs, the rest validate). 32+ chars.
JWT_SECRET=
# MeetingService -> EngagementService internal events. 32+ chars.
SERVICE_AUTH_SECRET=
# SQL Server edition: Express (free, 10 GB/db), or Standard/Enterprise if you hold a licence.
MSSQL_PID=Express

# ── LiveKit keys ──────────────────────────────────────────────────────────────
# LiveKit itself isn't deployed yet, but MeetingService won't start without these.
# Any key name (e.g. APIsms) and a secret of 32+ chars (openssl rand -base64 48).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Email (SMTP / Brevo) - leave SMTP_PASSWORD empty to only log emails ───────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SchoolSphere

# Landing-page lead notifications.
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_WHATSAPP=

# ── Optional integrations ─────────────────────────────────────────────────────
# Web Push (npx web-push generate-vapid-keys). Empty = push off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Razorpay online fee payment. Empty = "Pay online" hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
