# Caddy gets and renews Let's Encrypt certificates automatically. DOMAIN and APP_DOMAIN must both point at the
# VM's public IP, and ports 80 + 443 must be open, before the first `docker compose up`.
#
#   DOMAIN      (sms-schoolsphere.com)       marketing site: landing page only
#   APP_DOMAIN  (www.sms-schoolsphere.com)  the application: login, dashboard and every feature, plus the APIs
#   *.DOMAIN    (greenvalley.sms-schoolsphere.com ...)  one host per school, each serving the same application; the
#               school is identified from the hostname. Needs a wildcard DNS record (*.DOMAIN -> the VM's IP).
#   www.<school>.DOMAIN  (www.greenvalley.sms-schoolsphere.com)  redirects to <school>.DOMAIN. A wildcard record only
#               covers one label, so each school that wants this needs its own record: www.<school> -> the VM's IP.
{
	email {$ACME_EMAIL}

	# Certificates for school hosts are issued on their first visit (HTTP-01, so no DNS provider plugin is needed),
	# but only when AuthService says the subdomain belongs to a live school. That keeps strangers from making this
	# server request certificates for arbitrary names. The check goes through the internal :9123 site below, which
	# lets www.<school>.DOMAIN ask about <school>.DOMAIN.
	on_demand_tls {
		ask http://127.0.0.1:9123/
	}
}

# Internal only (not published): Caddy asks it before issuing an on-demand certificate. A www.<school>.DOMAIN name is
# checked as <school>.DOMAIN; any other name is passed to AuthService unchanged.
http://127.0.0.1:9123 {
	map {query.domain} {checked_domain} {
		~^www\.([a-z0-9-]+\.{$DOMAIN})$ {1}
		default {query.domain}
	}
	rewrite * /services/identity/api/tenant/domain-check?domain={checked_domain}
	reverse_proxy apigateway:8080
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# EXTRA_DOMAINS (optional, space-separated, e.g. www.) get certificates and permanently redirect to DOMAIN.
# Marketing site: serves the landing page and its static files; any other path is an application route and is
# sent to APP_DOMAIN (so /login, /dashboard, /students ... never run on the marketing origin).
{$DOMAIN} {$EXTRA_DOMAINS} {
	@extra not host {$DOMAIN}
	redir @extra https://{$DOMAIN}{uri} permanent

	encode zstd gzip
	import security_headers

	@marketing {
		path / /product /product/ /founder /founder/ /assets/* /favicon.svg /icons.svg /manifest.webmanifest /robots.txt /sitemap.xml /sw.js /config.js /google*.html
	}
	handle @marketing {
		reverse_proxy ui:80
	}

	# Everything else is the application.
	handle {
		redir https://{$APP_DOMAIN}{uri} 302
	}
}

# The application, served identically on APP_DOMAIN and on every school host. "/" has nothing to show here (the
# landing page lives on DOMAIN), so it goes to the login screen, which sends already-signed-in users on to their
# dashboard.
(app_site) {
	encode zstd gzip
	import security_headers

	@root path /
	redir @root /login 302

	# APIs: the gateway routes /services/<name>/... to each service; /api/... are its own endpoints.
	handle /services/* {
		reverse_proxy apigateway:8080
	}
	handle /api/* {
		reverse_proxy apigateway:8080
	}

	# LiveKit signalling (WebSocket). The prefix is stripped, so wss://APP_DOMAIN/livekit/rtc reaches LiveKit's /rtc.
	# Media doesn't come through here: it goes straight to LiveKit on 7881/tcp, 7882/udp and 3478/udp.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# Everything else is the SPA (nginx inside the ui image already falls back to index.html).
	handle {
		reverse_proxy ui:80
	}
}

{$APP_DOMAIN} {
	import app_site
}

# One host per school. APP_DOMAIN and DOMAIN above are more specific, so they never land here.
# This is a catch-all (https://) rather than a "*.DOMAIN" site on purpose: a wildcard site address makes Caddy skip the
# up-front certificates for the explicit hosts above (APP_DOMAIN, www), which then have no certificate at all.
# The AuthService domain-check still refuses every name that is not a live school.
https:// {
	tls {
		on_demand
	}

	# www.<school>.DOMAIN -> <school>.DOMAIN (only for a school: the certificate check above refuses other names).
	@wwwschool header_regexp wwwschool Host ^www\.([a-z0-9-]+)\.{$DOMAIN}$
	redir @wwwschool https://{re.wwwschool.1}.{$DOMAIN}{uri} permanent

	import app_site
}
