# Caddy gets and renews Let's Encrypt certificates automatically. DOMAIN must point at the VM's
# public IP, and ports 80 + 443 must be open, before the first `docker compose up`.
{
	email {$ACME_EMAIL}
}

# EXTRA_DOMAINS (optional, space-separated) also point at this VM: Caddy gets certificates for them and
# permanently redirects them to DOMAIN, so the SPA, CORS and auth all keep working on the one main origin.
{$DOMAIN} {$EXTRA_DOMAINS} {
	@extra not host {$DOMAIN}
	redir @extra https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	# APIs: the gateway routes /services/<name>/... to each service; /api/... are its own endpoints.
	handle /services/* {
		reverse_proxy apigateway:8080
	}
	handle /api/* {
		reverse_proxy apigateway:8080
	}

	# LiveKit signalling (WebSocket). The prefix is stripped, so wss://DOMAIN/livekit/rtc reaches LiveKit's /rtc.
	# Media doesn't come through here: it goes straight to LiveKit on 7881/tcp, 7882/udp and 3478/udp.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# Everything else is the SPA (nginx inside the ui image already falls back to index.html).
	handle {
		reverse_proxy ui:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

